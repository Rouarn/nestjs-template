# =============================================================================
# NestJS Template 环境变量示例
#
# 复制为 .env 后按需修改；真实 .env 已被 .gitignore 忽略，不要提交。
# 每条都标注了：用途 / 是否必填 / 默认值 / 格式示例 / 取值来源。
# 默认值与取值范围的唯一事实源是 src/config/validation.schema.ts（Joi），
# 除两个 JWT 密钥外，注释或删除整行即使用默认值（写成空值不算）。
#
# 配置加载顺序：.env.<NODE_ENV> → .env（同名键以前者为准），
# 已存在的系统环境变量优先级最高。
#
# 换成自己的项目时至少要改：NEST_JWT_SECRET、NEST_JWT_REFRESH_SECRET、
# NEST_APP_TITLE、NEST_PORT、NEST_BASE_URL、NEST_DATABASE_*、NEST_CORS_ORIGINS。
# =============================================================================

# ---------------------------- 服务基础 ----------------------------

# NODE_ENV：运行环境。【可选】默认 development；可选 development / production / test
# 示例：production（pnpm run deploy 打包时会强制为该值）
# 取值：本地开发填 development；生产环境会关闭 Swagger 并强制关闭数据库自动同步
NODE_ENV=development

# NEST_APP_TITLE：应用名称。【可选】默认 NestJS Template
# 示例：My Awesome API
# 取值：自行命名；用于启动日志与 Swagger 标题（生产环境会追加「- 生产环境」后缀）
NEST_APP_TITLE=NestJS Template

# NEST_PORT：HTTP 监听端口。【可选】默认 3000（Joi 默认值）
# 示例：8848（本文件取 8848，与 README 示例一致）
# 取值：自行指定；需与反向代理、防火墙放行端口保持一致
NEST_PORT=8848

# NEST_BASE_URL：服务对外访问基址。【可选】默认 http://localhost:3000（Joi 默认值）
# 示例：http://localhost:8848（本地）| https://api.example.com（生产，不带结尾斜杠）
# 取值：部署时填真实域名；上传接口返回的 completeUrl 与启动日志里的文档地址都基于它
NEST_BASE_URL=http://localhost:8848

# NEST_TRUST_PROXY：反向代理层数（Express trust proxy）。【可选】默认 0，范围 0-10
# 示例：0（本机直连）| 1（Nginx / 负载均衡之后）
# 取值：按实际代理层数填写；留 0 而部署在反代之后时，req.ip 会全是代理地址，限流与登录 IP 审计失真
NEST_TRUST_PROXY=0

# ---------------------------- API 版本控制 ----------------------------

# NEST_API_PREFIX：全局路由前缀。【可选】默认 api
# 示例：api（header 模式入口为 /api/...；uri 模式为 /api/v1/...）
# 取值：自行指定；前端 baseURL 与反向代理规则需同步修改
NEST_API_PREFIX=api

# NEST_API_DEFAULT_VERSION：默认 API 版本号。【可选】默认 1
# 示例：1
# 取值：自行指定；请求未显式声明版本时使用，字符串类型
NEST_API_DEFAULT_VERSION=1

# NEST_API_VERSIONING_TYPE：版本控制方式。【可选】默认 header；可选 uri / header
# 示例：header（本文件值）| uri（版本号写进路径）
# 取值：header 由请求头携带版本；uri 会把版本固定到 URL 上，前端调用方式随之不同
NEST_API_VERSIONING_TYPE=header

# NEST_API_VERSIONING_HEADER：版本请求头名称。【可选】默认 X-Api-Version
# 示例：X-Api-Version
# 取值：仅在 header 模式下生效；改名后前端请求头必须同步，否则会落到默认版本
NEST_API_VERSIONING_HEADER=X-Api-Version

# ---------------------------- 认证与 JWT ----------------------------

# NEST_JWT_SECRET：访问令牌（access）的签名密钥。【必填】无默认值，至少 32 字符
# 示例：32 字节随机数的 base64url 编码（约 43 字符），不要使用任何示例值
# 取值：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"；泄露等于登录态可被任意伪造
NEST_JWT_SECRET=dev_only_access_secret_please_replace_me_32

# NEST_JWT_REFRESH_SECRET：刷新令牌（refresh）的签名密钥。【必填】无默认值，至少 32 字符且必须与上一项不同
# 示例：再执行一次同样的生成命令，得到另一串随机字符
# 取值：同上命令；两项写成相同值会直接启动失败（Joi 校验拒绝）
NEST_JWT_REFRESH_SECRET=dev_only_refresh_secret_please_replace_me_32

# NEST_JWT_ACCESS_TOKEN_TTL：访问令牌有效期（秒）。【可选】默认 3600，最小 60
# 示例：3600（1 小时）| 900（15 分钟，更严格）
# 取值：按安全要求缩短；越长令牌泄露后可利用的窗口越大
NEST_JWT_ACCESS_TOKEN_TTL=3600

# NEST_JWT_REFRESH_TOKEN_TTL：刷新令牌有效期（秒）。【可选】默认 604800，最小 300
# 示例：604800（7 天）
# 取值：按「免登录保持多久」的业务要求决定；刷新一次即作废旧令牌
NEST_JWT_REFRESH_TOKEN_TTL=604800

# ---------------------------- 认证安全策略 ----------------------------

# NEST_BCRYPT_SALT_ROUNDS：密码哈希轮数（bcrypt cost）。【可选】默认 12，范围 10-15
# 示例：12
# 取值：越高越抗暴力破解但登录越慢；12 是常见平衡点，低配机器不要盲目上调
NEST_BCRYPT_SALT_ROUNDS=12

# NEST_AUTH_MAX_LOGIN_ATTEMPTS：连续登录失败多少次后锁定账号。【可选】默认 5，最小 1
# 示例：5
# 取值：按风控强度决定；达到该次数即写入锁定时间并开始指数退避
NEST_AUTH_MAX_LOGIN_ATTEMPTS=5

# NEST_AUTH_BASE_LOCK_DURATION：锁定基础时长（秒）。【可选】默认 1800，最小 1
# 示例：1800（30 分钟）
# 取值：实际锁定时长 = 基础时长 × 2^(失败次数 - 上限次数)，并受下一项封顶
NEST_AUTH_BASE_LOCK_DURATION=1800

# NEST_AUTH_MAX_LOCK_DURATION：锁定最长时长（秒）。【可选】默认 86400，最小 1
# 示例：86400（1 天）
# 取值：防止指数退避无限增长；应不小于 NEST_AUTH_BASE_LOCK_DURATION
NEST_AUTH_MAX_LOCK_DURATION=86400

# NEST_AUTH_TOKEN_CACHE_TTL：令牌版本缓存 TTL（秒）。【可选】默认 30，范围 0-3600
# 示例：30 | 0（每次请求都查库，最严格但开销最大）
# 取值：缓存位于进程内，多实例各自生效；改密 / 禁用 / 改角色后旧令牌最多延迟一个 TTL 失效
NEST_AUTH_TOKEN_CACHE_TTL=30

# ---------------------------- 数据库（MySQL） ----------------------------

# NEST_DATABASE_HOST：MySQL 主机地址。【可选】默认 127.0.0.1
# 示例：127.0.0.1（本机）| mysql.internal（云数据库内网地址）
# 取值：数据库实例连接地址；pnpm run db:init 建库脚本读取同一份配置
NEST_DATABASE_HOST=127.0.0.1

# NEST_DATABASE_PORT：MySQL 端口。【可选】默认 3306
# 示例：3306
# 取值：按实例实际暴露端口填写；云数据库常为自定义端口
NEST_DATABASE_PORT=3306

# NEST_DATABASE_USER：MySQL 用户名。【可选】默认 root
# 示例：root | nestjs_app
# 取值：建议创建专用账号而非直接使用 root；db:init 需要该账号具备建库建表权限
NEST_DATABASE_USER=root

# NEST_DATABASE_PASSWORD：MySQL 密码。【可选】默认空
# 示例：<你的数据库口令>，不要写入任何真实口令或公开过的示例口令
# 取值：数据库实例创建时设置；生产环境务必使用强口令，且 .env 不入库
NEST_DATABASE_PASSWORD=

# NEST_DATABASE_NAME：数据库名。【可选】默认 nestjs_template
# 示例：nestjs_template（换成自己的项目名，如 my_app）
# 取值：自行指定；db:init 会按此名建库，改名后需重新执行初始化
NEST_DATABASE_NAME=nestjs_template

# NEST_DATABASE_TABLE_PREFIX：表名前缀。【可选】默认 ra_，允许留空（不加前缀）
# 示例：ra_ | 留空
# 取值：必须与 db:init 建表脚本保持一致；改前缀等于换一套表，旧数据不会被自动迁移
NEST_DATABASE_TABLE_PREFIX=ra_

# NEST_DATABASE_SYNCHRONIZE：是否让 TypeORM 自动同步表结构。【可选】默认 false
# 示例：开发环境 true（首次启动自动建表）| 生产环境 false
# 取值：生产环境代码会强制关闭（结构变更必须走迁移脚本）；本文件为开发环境所以填 true
NEST_DATABASE_SYNCHRONIZE=true

# NEST_DATABASE_LOGGING：是否打印 SQL 日志。【可选】默认 false
# 示例：false | true（临时排查用）
# 取值：日常关闭避免刷屏；排查慢查询或 ORM 生成语句时临时打开
NEST_DATABASE_LOGGING=false

# NEST_DATABASE_POOL_SIZE：数据库连接池大小。【可选】默认 10，范围 1-100
# 示例：10
# 取值：按 MySQL max_connections 分配，确保「单实例池大小 × 实例数」不超过数据库上限
NEST_DATABASE_POOL_SIZE=10

# ---------------------------- 静态资源与文件上传 ----------------------------

# NEST_STATIC_ASSETS_DIR：上传文件与 api-docs.json 的落盘目录。【可选】默认 ./deploy/static
# 示例：./deploy/static（开发期）；打包后自动归一化为包内 ./static
# 取值：相对路径基于进程工作目录解析；换数据盘时填绝对路径，注意 pnpm run deploy 会清空 deploy/
NEST_STATIC_ASSETS_DIR=./deploy/static

# NEST_STATIC_ASSETS_PREFIX：静态资源 URL 前缀。【可选】默认 /static，必须以 / 开头且结尾不带 /
# 示例：/static
# 取值：自行指定；上传文件返回的相对地址、反向代理静态规则都依赖它（按 30 天 immutable 缓存）
NEST_STATIC_ASSETS_PREFIX=/static

# NEST_UPLOAD_ALLOWED_TYPES：允许上传的 MIME 白名单。【可选】默认 image/jpeg,image/png,image/gif,image/webp,application/pdf
# 示例：image/jpeg,image/png（逗号分隔，不带空格）
# 取值：按业务需要增删；留空表示不限制，但 HTML / SVG / JS / XML 等可执行类型始终被拒绝
NEST_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# NEST_UPLOAD_MAX_SIZE：单文件大小上限（字节）。【可选】默认 10485760（10MB）
# 示例：10485760 | 52428800（50MB）
# 取值：按业务决定；调大时需同步放宽反向代理的 client_max_body_size
NEST_UPLOAD_MAX_SIZE=10485760

# NEST_UPLOAD_MAX_FILES：单次批量上传的文件数上限。【可选】默认 10，范围 1-50
# 示例：10
# 取值：与前端一次可选文件数匹配；请求体上限按「文件数 × (单文件上限 + 64KB)」预估
NEST_UPLOAD_MAX_FILES=10

# ---------------------------- 跨域（CORS） ----------------------------

# NEST_CORS_ORIGINS：允许跨域访问的来源白名单。【可选】默认空（仅开发环境自动放行 localhost / 内网）
# 示例：http://localhost:8848（开发）| https://a.example.com,https://b.example.com（逗号分隔、不带结尾斜杠）
# 取值：前端独立域名访问 API 时逐个列出；写 "*" 会直接启动失败（服务固定开启 credentials）
NEST_CORS_ORIGINS=http://localhost:8848

# ---------------------------- 接口文档（Swagger） ----------------------------

# NEST_SWAGGER_TITLE：OpenAPI 文档标题。【可选】默认 NestJS Template
# 示例：NestJS Template
# 取值：自行命名；注意当前代码实际取 NEST_APP_TITLE 作为文档标题，本项暂未生效
NEST_SWAGGER_TITLE=NestJS Template

# NEST_SWAGGER_DESCRIPTION：OpenAPI 文档描述。【可选】默认 API documentation for NestJS Template
# 示例：API documentation for My App
# 取值：自行填写；会写入生成的 api-docs.json
NEST_SWAGGER_DESCRIPTION=API documentation for NestJS Template

# NEST_SWAGGER_PREFIX：Swagger UI 挂载路径。【可选】默认 /api-docs，必须以 / 开头
# 示例：/api-docs
# 取值：自行指定；仅非生产环境挂载，生产环境不暴露接口文档
NEST_SWAGGER_PREFIX=/api-docs

# NEST_SWAGGER_FILENAME：生成的 OpenAPI JSON 文件名。【可选】默认 api-docs.json
# 示例：api-docs.json
# 取值：写入静态资源目录供前端 gen:api 拉取；改名后前端脚本需同步
NEST_SWAGGER_FILENAME=api-docs.json

# ---------------------------- 日志 ----------------------------

# NEST_LOGGER_LEVEL：日志级别。【可选】默认 info；可选 error / warn / info / debug / verbose
# 示例：info | debug（排查问题时）
# 取值：同时作用于文件日志与控制台；生产环境建议 info 及以上
NEST_LOGGER_LEVEL=info

# NEST_LOGGER_DIR：日志目录。【可选】默认 ./deploy/logs
# 示例：./deploy/logs（开发期）；打包后自动归一化为包内 ./logs
# 取值：相对路径基于进程工作目录解析；需保证运行用户对该目录有写权限
NEST_LOGGER_DIR=./deploy/logs

# NEST_LOGGER_MAX_FILES：日志保留时长或份数。【可选】默认 14d
# 示例：14d | 30d | 30（保留 30 份）
# 取值：winston-daily-rotate-file 支持的格式；按天轮转并压缩归档
NEST_LOGGER_MAX_FILES=14d

# NEST_LOGGER_MAX_SIZE：单个日志文件大小上限。【可选】默认 20m
# 示例：20m | 100m
# 取值：超过上限即切分新文件；按磁盘容量与日志量调整
NEST_LOGGER_MAX_SIZE=20m

# NEST_LOG_BODY：是否把请求 / 响应体写入日志。【可选】默认 false
# 示例：false | true（仅联调排查时临时开启）
# 取值：默认关闭避免口令、令牌落盘；开启后仍会经 log-sanitize.helper 脱敏，但需自行确认业务敏感字段已覆盖
NEST_LOG_BODY=false

# ---------------------------- 数据库初始化（仅 db:init 使用） ----------------------------

# NEST_INIT_ADMIN_PASSWORD：pnpm run db:init 创建的初始管理员（admin）密码。【可选】无默认值
# 示例：Admin@2026-strong
# 取值：仅初始化脚本读取；不配置则随机生成 16 字符并只打印一次，账号已存在时不会覆盖
# NEST_INIT_ADMIN_PASSWORD=
